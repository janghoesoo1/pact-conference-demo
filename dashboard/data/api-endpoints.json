        "speaker": "홍길동",
        "description": "세션 설명"
      }
    },
    {
      "method": "PUT",
      "path": "/sessions/{id}",
      "description": "세션 수정",
      "hasId": true,
      "hasBody": true,
      "sampleBody": {
        "title": "수정된 세션",
        "speaker": "장호",
        "description": "수정된 설명"
      }
    },
    {
      "method": "DELETE",
      "path": "/sessions/{id}",
      "description": "세션 삭제",
      "hasId": true,
      "hasBody": false
    }
  ],
